<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>sparrow.connectors</groupId>
        <artifactId>sparrow-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>sparrow-metabase</artifactId>
    <name>Sparrow Metabase bridge</name>
    <description>Java side of the native Metabase driver: connection, metadata and query results over Arrow Flight
        SQL, called from the driver's Clojure code.</description>

    <dependencies>
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-client-core</artifactId>
        </dependency>

        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pro.surpin.arrowflight</groupId>
            <artifactId>arrow-flight-server</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- The in-process server reads its data through Hadoop FileSystem (provided in the server). -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client</artifactId>
            <version>${hadoop.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- sparrow-metabase-<version>-shaded.jar: the bridge with client core and its dependencies, bundled
                 into the Metabase plugin jar (sparrow-metabase/driver). Metabase plugins share one class loader with
                 Metabase and the other drivers (BigQuery brings its own Arrow/gRPC/Netty), so third-party packages
                 are relocated under sparrow.metabase.shaded. slf4j is left out (Metabase provides it), as are
                 netty-tcnative (JDK TLS) and Netty's epoll libraries (NIO), as in the Flink jar. META-INF/maven
                 is dropped so that tools.deps, which reads the poms inside a local jar, adds no unrelocated
                 dependencies. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase><goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>io.netty:netty-tcnative-boringssl-static</exclude>
                                    <exclude>io.netty:netty-tcnative-classes</exclude>
                                    <exclude>com.google.code.findbugs:jsr305</exclude>
                                    <exclude>javax.annotation:javax.annotation-api</exclude>
                                    <exclude>org.checkerframework:checker-qual</exclude>
                                    <exclude>com.google.errorprone:error_prone_annotations</exclude>
                                    <exclude>com.google.j2objc:j2objc-annotations</exclude>
                                    <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
                                    <exclude>com.google.guava:listenablefuture</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                            <relocations>
                                <relocation><pattern>org.apache.arrow</pattern><shadedPattern>sparrow.metabase.shaded.org.apache.arrow</shadedPattern></relocation>
                                <relocation><pattern>io.grpc</pattern><shadedPattern>sparrow.metabase.shaded.io.grpc</shadedPattern></relocation>
                                <relocation><pattern>io.netty</pattern><shadedPattern>sparrow.metabase.shaded.io.netty</shadedPattern></relocation>
                                <relocation><pattern>io.perfmark</pattern><shadedPattern>sparrow.metabase.shaded.io.perfmark</shadedPattern></relocation>
                                <!-- protobuf, common protos, guava, gson, flatbuffers -->
                                <relocation><pattern>com.google</pattern><shadedPattern>sparrow.metabase.shaded.com.google</shadedPattern></relocation>
                                <relocation><pattern>com.fasterxml.jackson</pattern><shadedPattern>sparrow.metabase.shaded.com.fasterxml.jackson</shadedPattern></relocation>
                                <relocation><pattern>org.bouncycastle</pattern><shadedPattern>sparrow.metabase.shaded.org.bouncycastle</shadedPattern></relocation>
                                <relocation><pattern>org.apache.commons</pattern><shadedPattern>sparrow.metabase.shaded.org.apache.commons</shadedPattern></relocation>
                            </relocations>
                            <filters>
                                <filter><artifact>*:*</artifact><excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                    <exclude>META-INF/versions/**</exclude>
                                    <exclude>META-INF/native/**</exclude>
                                    <exclude>META-INF/proguard/**</exclude>
                                    <exclude>android/**</exclude>
                                    <exclude>module-info.class</exclude>
                                    <exclude>META-INF/maven/**</exclude>
                                    <exclude>META-INF/native-image/**</exclude>
                                </excludes></filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
