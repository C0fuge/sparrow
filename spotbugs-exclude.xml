<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions. Every Match needs a comment with the reason. -->
<FindBugsFilter>
    <!--
      EI_EXPOSE_REP2: the client core's Configuration has setters, but the connector builds it once from the
      table or catalog options and never changes it afterwards; Flink serializes the source to the tasks anyway.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="sparrow.flink.FlightSource"/>
            <Class name="sparrow.flink.FlightCatalog"/>
        </Or>
    </Match>
</FindBugsFilter>
