<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions. Every Match needs a comment with the reason. -->
<FindBugsFilter>
    <!--
      EI_EXPOSE_REP2: the client core's Configuration has setters, but the connector builds it once from the
      table or catalog options and never changes it afterwards; Flink serializes the source to the tasks anyway.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="sparrow.flink.FlightSource"/>
            <Class name="sparrow.flink.FlightCatalog"/>
        </Or>
    </Match>
    <!--
      AT_*: QueryResult is read by one thread; only cancel() may run on another (Metabase's cancel channel),
      which touches nothing but the volatile `cancelled` flag and the volatile stream. The row counters are
      reader-thread state.
    -->
    <Match>
        <Class name="sparrow.metabase.QueryResult"/>
        <Or>
            <Bug pattern="AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE"/>
            <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
        </Or>
    </Match>
</FindBugsFilter>
